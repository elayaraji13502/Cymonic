# -------------------------------------------------------
# Adaptive Learning Coach — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# -------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/dbname  (async)
#         postgresql://user:password@host:port/dbname          (sync / Alembic)
DATABASE_URL=postgresql+asyncpg://alc_user:change_me@localhost:5432/adaptive_learning

# Sync URL used only by Alembic migrations
DATABASE_URL_SYNC=postgresql://alc_user:change_me@localhost:5432/adaptive_learning

# Application settings
APP_ENV=development          # development | test | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Logging level
LOG_LEVEL=INFO
