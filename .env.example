# -------------------------------------------------------
# Module 3 — Adaptive Decision Engine  |  Environment
# -------------------------------------------------------

# Groq API key — get yours free at https://console.groq.com
# Leave blank to run in pure deterministic-fallback mode.
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use for reasoning.
# Fast free-tier options:
#   llama3-8b-8192       (fastest, good quality)
#   llama3-70b-8192      (higher quality, slightly slower)
#   mixtral-8x7b-32768   (large context window)
#   gemma2-9b-it         (Google Gemma 2)
LLM_MODEL=llama3-8b-8192

# Timeout in seconds for a single LLM call (default: 15)
LLM_TIMEOUT_SECONDS=15

# Set to "true" to always skip the LLM and use deterministic fallback
FORCE_FALLBACK=false

# Application environment: development | production
APP_ENV=development
